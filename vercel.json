{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node tools/docs-tools/npm-downloads.mjs && npx nx build dev-app",
  "outputDirectory": "dist/apps/dev-app/browser",
  "installCommand": "npm ci",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/basic-grid",
      "destination": "/components/data-grid",
      "permanent": true
    },
    {
      "source": "/playground",
      "destination": "/components/data-grid/playground",
      "permanent": true
    },
    {
      "source": "/sorting",
      "destination": "/components/data-grid/sorting",
      "permanent": true
    },
    {
      "source": "/virtual-scroll",
      "destination": "/components/data-grid/virtual-scroll",
      "permanent": true
    },
    {
      "source": "/remote-data",
      "destination": "/components/data-grid/remote-data",
      "permanent": true
    },
    {
      "source": "/components/menubar/routed",
      "destination": "/components/menubar/routed/overview",
      "permanent": false
    },
    {
      "source": "/components/tabs/routed",
      "destination": "/components/tabs/routed/overview",
      "permanent": false
    },
    {
      "source": "/components/breadcrumb/routed",
      "destination": "/components/breadcrumb/routed/reports",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.csr.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-LMY6wYoFV9I4wWzxaq1N/dTpl4iurQktw706UCHK3vM=' 'sha256-kAfcqw26csDANg+3sFNLnJhAu/dwtoXmhGtbdzKKcEQ=' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://va.vercel-scripts.com https://vitals.vercel-insights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    },
    {
      "source": "/llms(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
