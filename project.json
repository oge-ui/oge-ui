{
  "name": "@oge/source",
  "$schema": "node_modules/nx/schemas/project-schema.json",
  "targets": {
    "use-client-check": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "node tools/check-use-client.mjs",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [{ "projects": ["tag:platform:react"], "target": "build" }]
    },
    "package-check": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "node tools/package-check.mjs",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [{ "projects": ["packages/**/*"], "target": "build" }]
    },
    "size-check": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "node tools/size-check.mjs",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [{ "projects": ["packages/**/*"], "target": "build" }]
    },
    "api-check": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "node tools/api-report.mjs",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [{ "projects": ["core", "behavior"], "target": "build" }]
    },
    "angular-compat-check": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "node tools/angular-compat/check.mjs",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [
        {
          "projects": ["tag:platform:angular", "tag:platform:agnostic"],
          "target": "build"
        }
      ]
    },
    "license-boundary-check": {
      "executor": "nx:run-commands",
      "outputs": [],
      "options": {
        "command": "node tools/license-boundary-check.mjs",
        "cwd": "{workspaceRoot}"
      },
      "dependsOn": [{ "projects": ["packages/**/*"], "target": "build" }]
    }
  }
}
