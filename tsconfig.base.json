{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@oge-ui/buttons": ["./packages/buttons/src/index.ts"],
      "@oge-ui/core": ["./packages/core/src/index.ts"],
      "@oge-ui/forms": ["./packages/forms/src/index.ts"],
      "@oge-ui/inputs": ["./packages/inputs/src/index.ts"],
      "@oge-ui/layout": ["./packages/layout/src/index.ts"],
      "@oge-ui/navigation": ["./packages/navigation/src/index.ts"],
      "@oge-ui/overlay": ["./packages/overlay/src/index.ts"],
      "@oge-ui/grid": ["./packages/grid/src/index.ts"],
      "@oge-ui/grid/export-excel": [
        "./packages/grid/export-excel/src/index.ts"
      ],
      "@oge-ui/grid/foundation": ["./packages/grid/foundation/src/index.ts"],
      "@oge-ui/bpmn": ["./packages/bpmn/src/index.ts"],
      "@oge-ui/gantt": ["./packages/gantt/src/index.ts"],
      "@oge-ui/gantt/export-excel": [
        "./packages/gantt/export-excel/src/index.ts"
      ],
      "@oge-ui/gantt/export-pdf": ["./packages/gantt/export-pdf/src/index.ts"],
      "@oge-ui/scheduler": ["./packages/scheduler/src/index.ts"],
      "@oge-ui/pivot": ["./packages/pivot/src/index.ts"],
      "@oge-ui/pivot/export-excel": [
        "./packages/pivot/export-excel/src/index.ts"
      ],
      "@oge-ui/grid/export-pdf": ["./packages/grid/export-pdf/src/index.ts"],
      "@oge-ui/tabs": ["./packages/tabs/src/index.ts"],
      "@oge-ui/tree-list": ["./packages/tree-list/src/index.ts"],
      "@oge-ui/tree-list/export-excel": [
        "./packages/tree-list/export-excel/src/index.ts"
      ],
      "oge-ui": ["./packages/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
