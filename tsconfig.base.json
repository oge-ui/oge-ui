{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@oge-ui/core": ["./packages/core/src/index.ts"],
      "@oge-ui/grid": ["./packages/grid/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
