  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "exceljs": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    }
  },
  "dependencies": {
    "@oge-ui/core": "0.6.0",
    "@oge-ui/grid": "0.6.0",
    "@oge-ui/inputs": "0.6.0",
    "@oge-ui/overlay": "0.6.0"
  },
  "sideEffects": false,
  "schematics": "./schematics/collection.json",
  "homepage": "https://ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/tree-list"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
