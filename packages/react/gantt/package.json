{
  "name": "@oge-ui/react-gantt",
  "version": "1.1.4",
  "description": "React Gantt chart from the OGE UI suite: a virtualized task tree pane and a timeline chart with summary brackets, milestone diamonds, baseline bars, FS/SS/FF/SF dependency arrows, critical path, forward auto-scheduling on work calendars, resource labels and a workload band, drag move/resize/progress with Escape-cancel, link drawing with cycle rejection, snapshot undo/redo, keyboard bar editing, a built-in context menu and task dialog, and Excel/PDF/PNG export — running the same framework-free Gantt engine and the same stylesheet as the Angular package. Source-available commercial license (free for evaluation and development).",
  "keywords": [
    "react",
    "gantt",
    "gantt-chart",
    "project-management",
    "timeline",
    "tasks",
    "dependencies",
    "critical-path",
    "excel-export",
    "pdf-export",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./export-excel": {
      "import": {
        "types": "./export-excel.d.ts",
        "default": "./export-excel.js"
      },
      "require": {
        "types": "./export-excel.d.cts",
        "default": "./export-excel.cjs"
      }
    },
    "./export-pdf": {
      "import": {
        "types": "./export-pdf.d.ts",
        "default": "./export-pdf.js"
      },
      "require": {
        "types": "./export-pdf.d.cts",
        "default": "./export-pdf.cjs"
      }
    },
    "./export-image": {
      "import": {
        "types": "./export-image.d.ts",
        "default": "./export-image.js"
      },
      "require": {
        "types": "./export-image.d.cts",
        "default": "./export-image.cjs"
      }
    },
    "./export-msproject": {
      "import": {
        "types": "./export-msproject.d.ts",
        "default": "./export-msproject.js"
      },
      "require": {
        "types": "./export-msproject.d.cts",
        "default": "./export-msproject.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.4",
    "@oge-ui/core": "1.1.4",
    "@oge-ui/gantt-engine": "1.1.4",
    "@oge-ui/react-forms": "1.1.4",
    "@oge-ui/react-overlay": "1.1.4"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/gantt"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "SEE LICENSE IN LICENSE"
}
