{
  "name": "@oge-ui/react-forms",
  "version": "0.12.0",
  "description": "React form layout from the OGE UI suite: responsive column layout, groups, tabbed/accordion/wizard sections, declarative validation rules and a validation summary — running the same item model and the same rule evaluator as the Angular forms package.",
  "keywords": [
    "react",
    "forms",
    "form-layout",
    "validation",
    "accessibility",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@oge-ui/behavior": "0.12.0",
    "@oge-ui/react-inputs": "0.12.0",
    "@oge-ui/react-layout": "0.12.0",
    "@oge-ui/react-navigation": "0.12.0",
    "@oge-ui/react-tabs": "0.12.0",
    "@oge-ui/react-upload": "0.12.0"
  },
  "homepage": "https://ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/forms"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
