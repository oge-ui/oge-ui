{
  "name": "@oge-ui/react",
  "version": "1.1.2",
  "description": "Umbrella package for the OGE React UI suite — installs and re-exports every @oge-ui/react-* family (buttons, inputs, tabs, layout, overlay) so an app can install once and import from one path. Real React components over the same framework-free engine and design tokens as the Angular suite.",
  "keywords": [
    "react",
    "ui-components",
    "component-library",
    "design-system",
    "accessibility",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./styles.css": "./styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.2",
    "@oge-ui/locales": "1.1.2",
    "@oge-ui/react-buttons": "1.1.2",
    "@oge-ui/react-forms": "1.1.2",
    "@oge-ui/react-grid": "1.1.2",
    "@oge-ui/react-inputs": "1.1.2",
    "@oge-ui/react-layout": "1.1.2",
    "@oge-ui/react-navigation": "1.1.2",
    "@oge-ui/react-overlay": "1.1.2",
    "@oge-ui/react-tabs": "1.1.2",
    "@oge-ui/react-tree-list": "1.1.2",
    "@oge-ui/react-upload": "1.1.2"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/oge"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
