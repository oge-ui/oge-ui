{
  "name": "@oge-ui/react-tabs",
  "version": "1.1.3",
  "description": "React tabs from the OGE UI suite: a WAI-ARIA APG tab strip and tab panel with data-driven or declarative tabs, automatic/manual activation, overflow scrolling with an all-tabs menu, closable tabs with async close guards and drag reordering — running the same selection/close/reorder pipelines and the same stylesheet as the Angular tabs package.",
  "keywords": [
    "react",
    "tabs",
    "tab-panel",
    "tab-strip",
    "navigation",
    "accessibility",
    "design-system",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./testing.d.ts",
        "default": "./testing.js"
      },
      "require": {
        "types": "./testing.d.cts",
        "default": "./testing.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@testing-library/dom": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.3",
    "@oge-ui/react-overlay": "1.1.3"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/tabs"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
