{
  "name": "@oge-ui/react-kanban",
  "version": "1.1.3",
  "description": "React Kanban board from the OGE UI suite: columns and swimlanes over a plain card array with field mapping, WIP limits, per-column virtualization, drag & drop with Escape-cancel and edge auto-scroll, Ctrl+Arrow keyboard card moving with live announcements, cancelable CRUD and move events, a built-in edit dialog, context menu and toolbar — running the same engine and the same stylesheet as the Angular Kanban package. Source-available commercial license (free for evaluation and development).",
  "keywords": [
    "react",
    "kanban",
    "kanban-board",
    "task-board",
    "swimlanes",
    "wip-limit",
    "drag-and-drop",
    "accessibility",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./export-excel": {
      "import": {
        "types": "./export-excel.d.ts",
        "default": "./export-excel.js"
      },
      "require": {
        "types": "./export-excel.d.cts",
        "default": "./export-excel.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@oge-ui/kanban-engine": "1.1.3",
    "@oge-ui/react-forms": "1.1.3",
    "@oge-ui/react-overlay": "1.1.3"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/kanban"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "SEE LICENSE IN LICENSE"
}
