{
  "name": "@oge-ui/react-inputs",
  "version": "1.1.4",
  "description": "React form editors from the OGE UI suite: text/number editors with the full oge field chrome — label modes, prefix/suffix slots, clear button, validation subscript, grapheme-accurate counter, password reveal, copy-to-clipboard — running the same commit pipeline, messages and design tokens as the Angular inputs package.",
  "keywords": [
    "react",
    "input",
    "textbox",
    "form",
    "editor",
    "validation",
    "accessibility",
    "design-system",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./testing.d.ts",
        "default": "./testing.js"
      },
      "require": {
        "types": "./testing.d.cts",
        "default": "./testing.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@testing-library/dom": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.4",
    "@oge-ui/react-navigation": "1.1.4",
    "@oge-ui/react-overlay": "1.1.4"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/inputs"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
