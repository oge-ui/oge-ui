{
  "name": "@oge-ui/react-grid",
  "version": "1.1.3",
  "description": "React data grid from the OGE UI suite: data-driven columns with render props, multi-column sorting, a typed filter row with an operator menu, global search, paging with a full pager, row and column virtualization, windowed remote loading and infinite scrolling, single/multiple/checkbox selection with shift ranges and Ctrl+A, Excel-like keyboard navigation, a focused row, pinned, resizable and reorderable columns, responsive column hiding, grouping with a drag-and-drop group panel, group/footer/total summaries and deferred group loading, master-detail, row and empty-state render props, row drag, state persistence, CSV export and clipboard copy — running the same framework-free grid engine, the same state slices and the same stylesheet as the Angular grid package.",
  "keywords": [
    "react",
    "data-grid",
    "datagrid",
    "table",
    "virtual-scroll",
    "sorting",
    "filtering",
    "paging",
    "accessibility",
    "design-system",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./export-excel": {
      "import": {
        "types": "./export-excel.d.ts",
        "default": "./export-excel.js"
      },
      "require": {
        "types": "./export-excel.d.cts",
        "default": "./export-excel.cjs"
      }
    },
    "./export-pdf": {
      "import": {
        "types": "./export-pdf.d.ts",
        "default": "./export-pdf.js"
      },
      "require": {
        "types": "./export-pdf.d.cts",
        "default": "./export-pdf.cjs"
      }
    },
    "./foundation": {
      "import": {
        "types": "./foundation.d.ts",
        "default": "./foundation.js"
      },
      "require": {
        "types": "./foundation.d.cts",
        "default": "./foundation.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./testing.d.ts",
        "default": "./testing.js"
      },
      "require": {
        "types": "./testing.d.cts",
        "default": "./testing.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "@testing-library/dom": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.3",
    "@oge-ui/core": "1.1.3",
    "@oge-ui/react-forms": "1.1.3",
    "@oge-ui/react-inputs": "1.1.3",
    "@oge-ui/react-layout": "1.1.3",
    "@oge-ui/react-overlay": "1.1.3"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/grid"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
