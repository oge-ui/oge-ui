{
  "name": "@oge-ui/react-layout",
  "version": "1.1.4",
  "description": "React layout containers and loading visuals from the OGE UI suite: accordion, splitter, toolbar, card, progress bar, load indicator, skeleton, avatar, badge, chip, alert, timeline, app bar, carousel, list view, data view and tile layout — running the same config defaults, message catalogs and stylesheet as the Angular layout package.",
  "keywords": [
    "react",
    "layout",
    "accordion",
    "splitter",
    "toolbar",
    "card",
    "avatar",
    "badge",
    "chip",
    "alert",
    "timeline",
    "app-bar",
    "carousel",
    "list-view",
    "data-view",
    "dashboard",
    "progress",
    "skeleton",
    "design-system",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.4",
    "@oge-ui/core": "1.1.4",
    "@oge-ui/react-overlay": "1.1.4"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/layout"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
