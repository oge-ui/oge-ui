{
  "name": "@oge-ui/react-pivot",
  "version": "1.1.3",
  "description": "React pivot grid from the OGE UI suite: local rows or a remote pre-aggregated store, four drag & drop field areas, multi-level column headers, expand/collapse on both axes, sub and grand totals, percent-of and running-total display modes, header and measure context menus, value filters, a field chooser, two-axis virtual scrolling, state persistence and CSV/Excel export — running the same framework-free pivot engine and the same stylesheet as the Angular pivot package. Source-available commercial license (free for evaluation and development).",
  "keywords": [
    "react",
    "pivot",
    "pivot-grid",
    "pivot-table",
    "olap",
    "analytics",
    "excel-export",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./export-excel": {
      "import": {
        "types": "./export-excel.d.ts",
        "default": "./export-excel.js"
      },
      "require": {
        "types": "./export-excel.d.cts",
        "default": "./export-excel.cjs"
      }
    },
    "./export-pdf": {
      "import": {
        "types": "./export-pdf.d.ts",
        "default": "./export-pdf.js"
      },
      "require": {
        "types": "./export-pdf.d.cts",
        "default": "./export-pdf.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.3",
    "@oge-ui/core": "1.1.3",
    "@oge-ui/pivot-engine": "1.1.3",
    "@oge-ui/react-grid": "1.1.3"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/pivot"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "SEE LICENSE IN LICENSE"
}
