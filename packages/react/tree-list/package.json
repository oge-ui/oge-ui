{
  "name": "@oge-ui/react-tree-list",
  "version": "1.1.4",
  "description": "React tree list (hierarchical data grid) from the OGE UI suite: flat parentId or nested data, lazy per-expansion child loading with remote match discovery, ancestor-preserving filtering (filter row, header filter, search, filter builder), sibling-scoped sorting, recursive tri-state selection, paging over the visible rows, row and column virtualization, editing in all five modes, drag and drop reparenting, treegrid keyboard navigation, keyboard context menus, pinned/resizable/reorderable columns and bands, state persistence and CSV/Excel export — running the same framework-free tree engine, the same grid state slices and the same stylesheet as the Angular tree-list package.",
  "keywords": [
    "react",
    "tree-list",
    "treelist",
    "tree-grid",
    "treegrid",
    "hierarchical-data",
    "virtual-scroll",
    "accessibility",
    "design-system",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./export-excel": {
      "import": {
        "types": "./export-excel.d.ts",
        "default": "./export-excel.js"
      },
      "require": {
        "types": "./export-excel.d.cts",
        "default": "./export-excel.cjs"
      }
    },
    "./export-pdf": {
      "import": {
        "types": "./export-pdf.d.ts",
        "default": "./export-pdf.js"
      },
      "require": {
        "types": "./export-pdf.d.cts",
        "default": "./export-pdf.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.4",
    "@oge-ui/core": "1.1.4",
    "@oge-ui/react-forms": "1.1.4",
    "@oge-ui/react-grid": "1.1.4",
    "@oge-ui/react-inputs": "1.1.4",
    "@oge-ui/react-layout": "1.1.4",
    "@oge-ui/react-overlay": "1.1.4"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/tree-list"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
