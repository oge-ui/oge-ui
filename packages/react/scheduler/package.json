{
  "name": "@oge-ui/react-scheduler",
  "version": "1.1.3",
  "description": "React scheduler / event calendar from the OGE UI suite: day, work-week, week, month, agenda, timeline and year views, all-day strip, pure-kernel overlap layout, drag & resize with Escape-cancel, drag-to-create, recurrence with occurrence-vs-series editing, resource grouping, reminders, an anchored appointment popup and a form editor — running the same framework-free scheduler engine and the same stylesheet as the Angular @oge-ui/scheduler. Source-available commercial license (free for evaluation and development).",
  "keywords": [
    "react",
    "scheduler",
    "calendar",
    "event-calendar",
    "appointments",
    "agenda",
    "timeline",
    "recurrence",
    "accessibility",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./export-ical": {
      "import": {
        "types": "./export-ical.d.ts",
        "default": "./export-ical.js"
      },
      "require": {
        "types": "./export-ical.d.cts",
        "default": "./export-ical.cjs"
      }
    },
    "./export-excel": {
      "import": {
        "types": "./export-excel.d.ts",
        "default": "./export-excel.js"
      },
      "require": {
        "types": "./export-excel.d.cts",
        "default": "./export-excel.cjs"
      }
    },
    "./export-pdf": {
      "import": {
        "types": "./export-pdf.d.ts",
        "default": "./export-pdf.js"
      },
      "require": {
        "types": "./export-pdf.d.cts",
        "default": "./export-pdf.cjs"
      }
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.3",
    "@oge-ui/core": "1.1.3",
    "@oge-ui/react-forms": "1.1.3",
    "@oge-ui/react-inputs": "1.1.3",
    "@oge-ui/react-overlay": "1.1.3",
    "@oge-ui/scheduler-engine": "1.1.3"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/react/scheduler"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "SEE LICENSE IN LICENSE"
}
