{
  "name": "@oge-ui/locales",
  "version": "1.1.2",
  "description": "Ready-made translations for every OGE UI message catalog — German, French, Spanish, Italian, Brazilian Portuguese, Turkish, Japanese, Simplified Chinese, Arabic and Hebrew. Framework-free data: one typed OgeLocalePack per language, each its own entry point (@oge-ui/locales/tr), applied with provideOgeLocale() (oge-ui) or <OgeLocaleProvider> (@oge-ui/react).",
  "keywords": [
    "i18n",
    "l10n",
    "localization",
    "translations",
    "locale",
    "rtl",
    "angular",
    "react",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.esm.js",
      "require": "./index.cjs.js"
    },
    "./de": {
      "types": "./de.d.ts",
      "import": "./de.esm.js",
      "require": "./de.cjs.js"
    },
    "./fr": {
      "types": "./fr.d.ts",
      "import": "./fr.esm.js",
      "require": "./fr.cjs.js"
    },
    "./es": {
      "types": "./es.d.ts",
      "import": "./es.esm.js",
      "require": "./es.cjs.js"
    },
    "./it": {
      "types": "./it.d.ts",
      "import": "./it.esm.js",
      "require": "./it.cjs.js"
    },
    "./pt-BR": {
      "types": "./pt-BR.d.ts",
      "import": "./pt-BR.esm.js",
      "require": "./pt-BR.cjs.js"
    },
    "./tr": {
      "types": "./tr.d.ts",
      "import": "./tr.esm.js",
      "require": "./tr.cjs.js"
    },
    "./ja": {
      "types": "./ja.d.ts",
      "import": "./ja.esm.js",
      "require": "./ja.cjs.js"
    },
    "./zh-CN": {
      "types": "./zh-CN.d.ts",
      "import": "./zh-CN.esm.js",
      "require": "./zh-CN.cjs.js"
    },
    "./ar": {
      "types": "./ar.d.ts",
      "import": "./ar.esm.js",
      "require": "./ar.cjs.js"
    },
    "./he": {
      "types": "./he.d.ts",
      "import": "./he.esm.js",
      "require": "./he.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "peerDependencies": {
    "@oge-ui/behavior": "1.1.2",
    "@oge-ui/bpmn-engine": "1.1.2",
    "@oge-ui/charts-engine": "1.1.2",
    "@oge-ui/gantt-engine": "1.1.2",
    "@oge-ui/kanban-engine": "1.1.2",
    "@oge-ui/pivot-engine": "1.1.2",
    "@oge-ui/scheduler-engine": "1.1.2"
  },
  "peerDependenciesMeta": {
    "@oge-ui/behavior": {
      "optional": true
    },
    "@oge-ui/bpmn-engine": {
      "optional": true
    },
    "@oge-ui/charts-engine": {
      "optional": true
    },
    "@oge-ui/gantt-engine": {
      "optional": true
    },
    "@oge-ui/kanban-engine": {
      "optional": true
    },
    "@oge-ui/pivot-engine": {
      "optional": true
    },
    "@oge-ui/scheduler-engine": {
      "optional": true
    }
  },
  "schematics": "./schematics/collection.json",
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/locales"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
