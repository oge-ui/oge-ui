{
  "name": "oge-ui",
  "version": "0.7.0",
  "description": "Umbrella package for the MIT-licensed OGE Angular UI suite — installs and re-exports the open-source @oge-ui/* packages: Data Grid, Tree List, Select Box, Buttons, Inputs and Overlay. The commercial Pivot Grid (@oge-ui/pivot) is installed separately.",
  "keywords": [
    "angular",
    "ui-components",
    "component-library",
    "data-grid",
    "tree-list",
    "forms",
    "signals",
    "standalone-components"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@oge-ui/core": "0.7.0",
    "@oge-ui/grid": "0.7.0",
    "@oge-ui/tree-list": "0.7.0",
    "@oge-ui/buttons": "0.7.0",
    "@oge-ui/overlay": "0.7.0",
    "@oge-ui/inputs": "0.7.0",
    "@oge-ui/tabs": "0.7.0",
    "@oge-ui/layout": "0.7.0",
    "@oge-ui/navigation": "0.7.0"
  },
  "sideEffects": false,
  "schematics": "./schematics/collection.json",
  "homepage": "https://ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
