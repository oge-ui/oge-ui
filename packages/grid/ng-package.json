{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/packages/grid",
  "allowedNonPeerDependencies": [
    "@oge-ui/core",
    "@oge-ui/inputs",
    "@oge-ui/forms",
    "@oge-ui/layout",
    "@oge-ui/overlay"
  ],
  "assets": [
    "llms.txt",
    {
      "input": "src/lib/styles/themes",
      "glob": "*.css",
      "output": "themes"
    }
  ],
  "lib": {
    "entryFile": "src/index.ts"
  }
}
