    "@angular/forms": "^22.0.0"
  },
  "dependencies": {
    "@oge-ui/behavior": "0.13.1",
    "@oge-ui/core": "0.13.1",
    "@oge-ui/inputs": "0.13.1",
    "@oge-ui/forms": "0.13.1",
    "@oge-ui/layout": "0.13.1",
    "@oge-ui/overlay": "0.13.1"
  },
  "exports": {
