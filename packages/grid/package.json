{
  "name": "@oge-ui/grid",
  "version": "1.1.8",
  "description": "Signal-based Angular data grid: virtualized rendering for 100k+ rows, filtering, grouping, editing, selection, column virtualization, state persistence and Excel/PDF export. Free, open-source MIT alternative to AG Grid Enterprise.",
  "keywords": [
    "angular",
    "data-grid",
    "datagrid",
    "grid",
    "table",
    "free-data-grid",
    "open-source-data-grid",
    "ag-grid-alternative",
    "signals",
    "zoneless",
    "virtual-scroll",
    "excel-export",
    "pdf-export",
    "standalone-components"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular/common": ">=21.2.0 <24.0.0",
    "@angular/core": ">=21.2.0 <24.0.0",
    "@angular/forms": ">=21.2.0 <24.0.0",
    "@angular/cdk": ">=21.2.0 <24.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/cdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@oge-ui/behavior": "1.1.8",
    "@oge-ui/core": "1.1.8",
    "@oge-ui/inputs": "1.1.8",
    "@oge-ui/forms": "1.1.8",
    "@oge-ui/layout": "1.1.8",
    "@oge-ui/overlay": "1.1.8"
  },
  "exports": {
    "./themes/*": "./themes/*"
  },
  "schematics": "./schematics/collection.json",
  "sideEffects": [
    "*.css"
  ],
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/grid"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT"
}
