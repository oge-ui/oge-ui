{
  "name": "@oge-ui/kanban-engine",
  "version": "1.1.4",
  "description": "Framework-free engine behind the OGE UI Kanban board, shared by its Angular and React render layers: card normalization and field write-back, swimlane grouping, search, drag hit-testing and edge auto-scroll math, per-column virtual windows, WIP arithmetic, keyboard navigation and move planning, the edit-dialog form model and the message catalog. Source-available commercial license (free for evaluation and development).",
  "keywords": [
    "kanban",
    "kanban-board",
    "headless",
    "drag-and-drop",
    "wip-limit",
    "swimlanes",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@oge-ui/behavior": "1.1.4",
    "@oge-ui/core": "1.1.4"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/kanban-engine"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "module": "./index.esm.js",
      "default": "./index.cjs.js"
    },
    "./export-excel": {
      "types": "./export-excel.d.ts",
      "module": "./export-excel.esm.js",
      "default": "./export-excel.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    }
  }
}
