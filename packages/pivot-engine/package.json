{
  "name": "@oge-ui/pivot-engine",
  "version": "1.1.2",
  "description": "Framework-free pivot grid engine behind @oge-ui/pivot (Angular) and @oge-ui/react-pivot (React): field layout model, axis and header layout math, two-axis virtualization windows, the remote-store adapter, header and measure menus, value filters, the field chooser, keyboard navigation, persistence snapshots, the message catalog and the Excel workbook builder. Source-available commercial license (free for evaluation and development).",
  "keywords": [
    "pivot",
    "pivot-grid",
    "pivot-table",
    "olap",
    "analytics",
    "headless",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@oge-ui/behavior": "1.1.2",
    "@oge-ui/core": "1.1.2"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "module": "./index.esm.js",
      "default": "./index.cjs.js"
    },
    "./export-excel": {
      "types": "./export-excel.d.ts",
      "module": "./export-excel.esm.js",
      "default": "./export-excel.cjs.js"
    },
    "./export-pdf": {
      "types": "./export-pdf.d.ts",
      "module": "./export-pdf.esm.js",
      "default": "./export-pdf.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "jspdf-autotable": {
      "optional": true
    }
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/pivot-engine"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "SEE LICENSE IN LICENSE"
}
