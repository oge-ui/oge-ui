{
  "name": "@oge-ui/spreadsheet-engine",
  "version": "1.1.8",
  "description": "Framework-free engine of the OGE UI Spreadsheet, shared by its Angular and React render layers: a dependency-free xlsx reader (styles, merges, links, notes, pictures, charts, conditional formats, opaque passthrough, import issues), Excel number formats, the paint model (Excel-measured column widths, row heights, border precedence and text fitting) and the viewer core (selection, Excel keyboard map, find, copy). Runs without a DOM (Node, Web Workers). Source-available commercial license (free for evaluation and development).",
  "keywords": [
    "spreadsheet",
    "excel",
    "xlsx",
    "workbook",
    "number-format",
    "headless",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "module": "./index.esm.js",
      "default": "./index.cjs.js"
    },
    "./powerpoint": {
      "types": "./powerpoint.d.ts",
      "module": "./powerpoint.esm.js",
      "default": "./powerpoint.cjs.js"
    },
    "./word": {
      "types": "./word.d.ts",
      "module": "./word.esm.js",
      "default": "./word.cjs.js"
    },
    "./pdf": {
      "types": "./pdf.d.ts",
      "module": "./pdf.esm.js",
      "default": "./pdf.cjs.js"
    },
    "./import": {
      "types": "./import.d.ts",
      "module": "./import.esm.js",
      "default": "./import.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "dependencies": {
    "@oge-ui/behavior": "1.1.8",
    "@oge-ui/core": "1.1.8"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/spreadsheet-engine"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "SEE LICENSE IN LICENSE",
  "peerDependencies": {
    "pdfjs-dist": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  }
}
