{
  "name": "@oge-ui/scheduler-engine",
  "version": "1.1.3",
  "description": "Framework-free engine behind the OGE UI scheduler: view-model builders, transitive-overlap column layout, lane packing, an RFC 5545 RRULE-subset parser and expander, gesture math, keyboard maps, the editing/recurrence/CRUD core, default config and message catalogs — shared by @oge-ui/scheduler (Angular) and @oge-ui/react-scheduler. Source-available commercial license (free for evaluation and development).",
  "keywords": [
    "scheduler",
    "calendar",
    "event-calendar",
    "rrule",
    "recurrence",
    "headless",
    "framework-free",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@oge-ui/behavior": "1.1.3",
    "@oge-ui/core": "1.1.3"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/scheduler-engine"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "module": "./index.esm.js",
      "default": "./index.cjs.js"
    },
    "./export-ical": {
      "types": "./export-ical.d.ts",
      "module": "./export-ical.esm.js",
      "default": "./export-ical.cjs.js"
    },
    "./export-excel": {
      "types": "./export-excel.d.ts",
      "module": "./export-excel.esm.js",
      "default": "./export-excel.cjs.js"
    },
    "./export-pdf": {
      "types": "./export-pdf.d.ts",
      "module": "./export-pdf.esm.js",
      "default": "./export-pdf.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    }
  }
}
