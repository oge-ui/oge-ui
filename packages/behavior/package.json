{
  "name": "@oge-ui/behavior",
  "version": "1.1.3",
  "description": "Framework-free interaction and accessibility layer behind the OGE UI suite: popup positioning, focus trapping, the shared overlay Escape stack and body scroll locking.",
  "keywords": [
    "accessibility",
    "a11y",
    "headless",
    "focus-trap",
    "popup",
    "positioning",
    "scroll-lock",
    "wai-aria",
    "typescript"
  ],
  "author": "kaya2m",
  "publishConfig": {
    "access": "public"
  },
  "main": "./index.cjs.js",
  "module": "./index.esm.js",
  "types": "./index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@oge-ui/core": "1.1.3"
  },
  "homepage": "https://www.ogeui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oge-ui/oge-ui.git",
    "directory": "packages/behavior"
  },
  "bugs": "https://github.com/oge-ui/oge-ui/issues",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "module": "./index.esm.js",
      "default": "./index.cjs.js"
    },
    "./export-excel": {
      "types": "./export-excel.d.ts",
      "module": "./export-excel.esm.js",
      "default": "./export-excel.cjs.js"
    },
    "./export-pdf": {
      "types": "./export-pdf.d.ts",
      "module": "./export-pdf.esm.js",
      "default": "./export-pdf.cjs.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "jspdf-autotable": {
      "optional": true
    }
  }
}
